# Session cookie for the vibes.ai account (from the browser's DevTools -> Application -> Cookies).
# Required only for live end-to-end tests: `npm run test:live`.
VIBES_SESSION_COOKIE=meta_session=YOUR_SESSION_VALUE_HERE

# Live tests are self-contained: they create a test project, run against it,
# and delete the project (plus its content items) afterwards. Nothing is left
# behind in the account.
#
# Set to 1 to also run the heavy generation tests (text-to-video + extend).
# These consume generation quota, so they are disabled by default:
# VIBES_RUN_HEAVY=1

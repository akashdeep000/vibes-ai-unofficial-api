# Session cookie for the vibes.ai account — used by `autoSession()` on
# servers/headless deployments, takes precedence over browser browser-based
# auto-login) and by the live end-to-end tests (`npm run test:live`).
# Leave it UNSET (or blank it) to let `autoSession()` mint a fresh
# session from your Meta account linked in your browser; on user is asked whether
# to sign in to the browser once.
VIBES_SESSION_COOKIE=

# On a local machine you usually need nothing at all:
#
#   const client = new VibesClient({ session: autoSession() });
#
# `autoSession()` replays the Meta OIDC login using your browser's Meta
# account cookies, caches the minted session in ./.vibes-session.json, and
# re-logins on 401. Browsers are auto-detected (helium -> chrome -> chromium
# -> brave -> edge -> firefox -> safari); overrides (see src/auth/browser-session.ts):
# VIBES_BROWSER=helium
# VIBES_PROFILE_DIR=
# Where the minted session is cached (default ./.vibes-session.json):
# VIBES_SESSION_FILE=

# Live tests are self-contained: they create a test project, run against it,
# and delete the project (plus its content items) afterwards. Nothing is left
# behind in the account.
#
# Set to 1 to also run the heavy generation tests (text-to-video + extend).
# These consume generation quota, so they are disabled by default:
# VIBES_RUN_HEAVY=1

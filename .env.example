# Session cookie for the vibes.ai account — used by `browserSession()` on
# servers/headless deployments (takes precedence over the browser chain), and
# by the live end-to-end tests (`npm run test:live`).
# Copy it from the browser's DevTools -> Network -> any request ->
# Request headers -> cookie, then paste it here (or export it in your host).
VIBES_SESSION_COOKIE=meta_session=YOUR_SESSION_VALUE_HERE

# `browserSession()` resolves: env cookie -> helium browser -> chrome ->
# chromium -> brave -> edge -> firefox -> safari. On local machines with a
# browser you can skip the manual copy entirely:
#
#   const client = new VibesClient({ session: browserSession() });
#
# Optional browser-sync overrides (see src/auth/browser-session.ts):
# VIBES_BROWSER=helium
# VIBES_PROFILE_DIR=

# Live tests are self-contained: they create a test project, run against it,
# and delete the project (plus its content items) afterwards. Nothing is left
# behind in the account.
#
# Set to 1 to also run the heavy generation tests (text-to-video + extend).
# These consume generation quota, so they are disabled by default:
# VIBES_RUN_HEAVY=1
